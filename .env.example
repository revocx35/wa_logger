# wa_logger — example configuration. Do not edit by hand for a first install:
#   scripts/setup.sh   generates .env with strong random secrets.

SITE_ADDRESS=wa.example.com          # domain or IP you open wa_logger at
CADDY_TLS=you@example.com            # ACME e-mail for Let's Encrypt, or "internal" (LAN/IP, self-signed CA)
HTTPS_PORT=443
HTTP_PORT=80
PUBLIC_ORIGIN=https://wa.example.com # exact browser origin (add :port if not 443)

SETUP_TOKEN=change-me-to-32-random-characters
VNC_PASSWORD=change-me-24-random-chars

COOKIE_SECURE=true
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
MEDIA_MAX_MB=100
HISTORY_PER_CHAT=200
RECONCILE_MINUTES=10
LOG_LEVEL=info
SCREEN=1280x800x24
