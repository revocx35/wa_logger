# wa_logger — example configuration. Do not edit by hand for a first install:
#   scripts/setup.sh   generates .env with strong random secrets.

SITE_ADDRESS=wa.example.com          # domain or IP you open wa_logger at
CADDY_TLS=you@example.com            # ACME e-mail for Let's Encrypt, or "internal" (LAN/IP, self-signed CA)
HTTPS_PORT=443
HTTP_PORT=80
PUBLIC_ORIGIN=https://wa.example.com # exact browser origin (add :port if not 443)

SETUP_TOKEN=change-me-to-32-random-characters
CONTROL_SECRET=change-me-32-random-chars   # app <-> chromium containers only (older .env files: VNC_PASSWORD still works)

# Multiple users: the admin creates users in the web UI and can give each their own port
MAX_USERS=10
EXTRA_PORTS=8101-8110                # ports the admin may open for other users
EXTRA_BIND=127.0.0.1                 # set 0.0.0.0 / a LAN address if the proxy for those users is on another host

COOKIE_SECURE=true                   # true | auto (Secure only when your TLS proxy reports HTTPS) | false

# HTTP mode behind your own TLS reverse proxy (written by: setup.sh --http-only)
# CADDY_CONFIG=Caddyfile.http
# HTTPS_BIND=127.0.0.1
# COOKIE_SECURE=auto
# TRUST_PROXY=2
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
MEDIA_MAX_MB=100
HISTORY_PER_CHAT=200
RECONCILE_MINUTES=10
LOG_LEVEL=info
SCREEN=1280x800x24
