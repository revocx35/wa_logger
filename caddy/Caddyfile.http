# Plain-HTTP mode (CADDY_CONFIG=Caddyfile.http): use when your own reverse proxy terminates TLS in front of
# wa_logger. Do NOT expose this port directly to the internet — only your reverse proxy should reach it.
{
	admin off
	auto_https off
	servers {
		# Pass through X-Forwarded-For/-Proto/-Host set by your reverse proxy (private networks only), so the
		# app sees the real client IP (brute-force throttling) and knows the request came in over HTTPS.
		trusted_proxies static private_ranges
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
	log {
		output stdout
		level WARN
	}
}

# One site body for every port: the default one below and the extra ones from /tmp/extra-ports.caddy
# (generated by extra-ports.sh from EXTRA_PORTS). {args[0]} is the port of the app to forward to.
(wal_site) {
	request_body {
		max_size 1MB
	}

	header {
		-Server
		-Via
	}

	@static not path /api/*
	encode @static zstd gzip

	reverse_proxy app:{args[0]} {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

:80 {
	import wal_site 8080
}

import /tmp/extra-ports*.caddy
