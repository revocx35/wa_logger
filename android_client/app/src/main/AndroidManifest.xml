<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice messages and calls (asked for when recording the first one / starting the first call). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls: keep the microphone while the app is in the background (an ongoing-call notification is shown). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Video calls (asked for when the camera is first switched on). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calls: earpiece/speaker routing and the call audio mode. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Incoming calls vibrate while the app is open. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 17+ (target SDK 37): needed to reach a server on a private address (home network, 192.168.x.x). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- No backups of any kind: the app holds an (encrypted) session cookie and its Keystore key. -->
    <application
        android:name=".WaLoggerApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.WaLogger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- authentik sign-in: the browser comes back to <applicationId>:/authentik (data/AuthentikSignIn.kt). -->
        <activity
            android:name=".data.AuthentikRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>

        <!-- Holds an ongoing call in the foreground (microphone); see media/CallForegroundService.kt. -->
        <service
            android:name=".media.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Temporary copies for "Open with…" (app cache, read-only grants, deleted on next start). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
